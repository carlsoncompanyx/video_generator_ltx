# RunPod / worker configuration. Do not put real credentials in this file.
RUNPOD_API_KEY=
RUNPOD_NETWORK_VOLUME_PATH=/runpod-volume
HF_TOKEN=
MODEL_BOOTSTRAP_DOWNLOAD=false
LTX_BOOTSTRAP_PROFILE=ltx25_bf16_core
LTX_BOOTSTRAP_LORAS=
COMFY_TIMEOUT_SECONDS=3600
LTX_MAX_INPUT_BYTES=104857600
LTX_MAX_BASE64_OUTPUT_BYTES=20971520

# Optional S3-compatible output used by runpod-workers/worker-comfyui's
# supported upload helper. Leave unset for small smoke clips returned inline.
BUCKET_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
BUCKET_NAME=
